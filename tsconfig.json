{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"composite": true,
		"jsx": "react-jsx",
		"paths": {
			"@workspace/ui/*": ["./src/*"]
		}
	},
	"include": [".", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.css"],
	"exclude": ["node_modules", "dist"]
}
