{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"composite": true,
		"jsx": "react-jsx",
		"target": "esnext",
		"lib": ["esnext", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"@workspace/ui/*": ["./src/*"]
		}
	},
	"include": [".", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.css"],
	"exclude": ["node_modules", "dist"]
}
